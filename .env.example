# Copy to .env.local and fill in. Never commit real values.

# --- Model server -----------------------------------------------------------
# Base URL of the OpenAI-compatible inference server (no trailing slash).
VAST_API_URL=http://localhost:8000
# Model name the server exposes on /v1/chat/completions.
SERVED_MODEL_NAME=tomaris

# --- Database (Neon / Postgres) ---------------------------------------------
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Auth (Better Auth) -----------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# Optional Google sign-in. Set NEXT_PUBLIC_GOOGLE_AUTH=1 to show the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH=0

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Tomaris <no-reply@example.com>"
# Inbox that receives contact-form and in-app feedback messages.
CONTACT_EMAIL=

# --- Admin ------------------------------------------------------------------
# Comma-separated emails allowed to open /admin.
ADMIN_EMAILS=

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
