# Vast.ai inference server (host:port of your running vLLM instance)
VAST_API_URL=http://your-vast-ip:port

# HuggingFace token (read access to private Tomaris/Tomaris.ai model)
HUGGINGFACE_TOKEN=your-hf-token

# Model settings. The RAG server ignores the `model` field in a request and
# always serves its own VLLM_MODEL (the DPO adapter, "tomaris"), so these are
# labels only -- they do not select a model.
MODEL_NAME=tomaris
SERVED_MODEL_NAME=tomaris
